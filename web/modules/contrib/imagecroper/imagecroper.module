<?php

/**
 * @file
 * Contains imagecroper.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function imagecroper_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.imagecroper':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Edit images in image form: rotate, crop');
      $output .= '</dl>';
      return $output;
  }
}

/**
 * Implements hook_field_widget_info_alter().
 */
function imagecroper_field_widget_info_alter(array &$info) {
  // Let a new field type re-use an existing widget.
  $info['image_image']['field_types'][] = 'imagecroper';
}
